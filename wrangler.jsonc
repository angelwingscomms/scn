{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "scn",
	"compatibility_date": "2026-08-07",
	"compatibility_flags": [
		"nodejs_als"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"routes": [
		{
			"pattern": "scn.apexlinks.org",
			"custom_domain": true
		}
	],
	"r2_buckets": [
		{
			"binding": "F",
			"bucket_name": "scn"
		}
	],
	"observability": {
		"enabled": true
	}
}
